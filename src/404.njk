---
layout: base.njk
title: "404 — Page Not Found — Camwyn & Co."
permalink: /404.html
eleventyExcludeFromCollections: true
---

<section 
  class="u-py-section"
  x-data
>
  <div class="o-container o-container--wide">
    
    <!-- Eyebrow -->
    <p class="c-hero__eyebrow" x-text="$store.compass.result && $store.compass.archetypes[$store.compass.result]?.notFound ? $store.compass.archetypes[$store.compass.result].notFound.eyebrow : 'A wrong turn on a quiet lane'">A wrong turn on a quiet lane</p>

    <!-- Serif Title -->
    <h1 class="c-hero__title" style="max-width: 25ch;" x-text="$store.compass.result && $store.compass.archetypes[$store.compass.result]?.notFound ? $store.compass.archetypes[$store.compass.result].notFound.title : 'The page you are looking for has moved or taken a detour.'">The page you are looking for has moved or taken a detour.</h1>

    <!-- Body Text with Color Punch (Uses x-html) -->
    <p 
      class="u-font-serif" 
      style="font-size: 1.375rem; color: var(--color-primary); max-width: 45ch; margin-top: var(--space-md); line-height: 1.5;"
      x-html="$store.compass.result && $store.compass.archetypes[$store.compass.result]?.notFound ? $store.compass.archetypes[$store.compass.result].notFound.body : 'Camwyn &amp; Co. is built on generous tables and steady craft, but <span class=\'u-text-clay\'>this particular path leads nowhere right now.</span>'"
    >Camwyn &amp; Co. is built on generous tables and steady craft, but <span class="u-text-clay">this particular path leads nowhere right now.</span></p>

    <!-- Call to Action Controls -->
    <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); align-items: center; flex-wrap: wrap;">
      <a 
        href="/"
        :href="$store.compass.result && $store.compass.archetypes[$store.compass.result]?.notFound ? $store.compass.archetypes[$store.compass.result].notFound.ctaUrl : '/'" 
        class="c-btn c-btn--primary" 
        style="font-size: 0.875rem; padding: 0.875rem 1.5rem;"
        x-text="$store.compass.result && $store.compass.archetypes[$store.compass.result]?.notFound ? $store.compass.archetypes[$store.compass.result].notFound.ctaText : 'Take a detour home ↗'"
      >Take a detour home ↗</a>

      <template x-if="$store.compass.result">
        <span class="u-font-mono" style="font-size: 0.8125rem; color: var(--color-muted-clay-text);">
          Tailored for <strong style="color: var(--color-primary);" x-text="($store.compass.archetypes[$store.compass.result]?.name || $store.compass.result).toUpperCase()"></strong>
        </span>
      </template>
    </div>

  </div>
</section>