---
layout: base.njk
title: "Notes from the Field — Camwyn & Co"
description: "Dispatches, workbench notes, table stories, and collaborative experiments from Camwyn & Co."
permalink: "/notes/index.html"
---

<section class="u-py-section" aria-labelledby="notes-index-heading">
  <div class="o-container o-container--wide">
    <div class="o-grid" style="align-items: end; margin-bottom: var(--space-xl);">
      <div style="grid-column: span 8;">
        <p class="c-hero__eyebrow">Around here lately</p>
        <h1 id="notes-index-heading" class="c-hero__title" style="font-size: clamp(2.5rem, 5vw, 4.25rem); margin-bottom: 0;">
          Notes<br>from<br>the field.
        </h1>
      </div>
      <div style="grid-column: span 4;">
        <p class="c-hero__lead" style="font-size: 1rem; border-top: 1px solid var(--color-outline-variant); padding-top: var(--space-md);">
          A living collection of things we're making, learning, tasting, and following. Below are the latest dispatches from each perspective in our house of projects.
        </p>
      </div>
    </div>

    <!-- Optional Archetype Filter Pills -->
    <div x-data="{ activeFilter: 'all' }">
      <div class="o-cluster" style="gap: 0.5rem; margin-bottom: var(--space-xl);" role="group" aria-label="Filter notes by archetype">
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'all' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'all'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          All Notes ({{ collections.notes.length }})
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'gatherer' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'gatherer'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          The Gatherer
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'craftsman' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'craftsman'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          The Craftsman
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'explorer' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'explorer'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          The Explorer
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'catalyst' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'catalyst'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          The Catalyst
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'storykeeper' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'storykeeper'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;"
        >
          The Storykeeper
        </button>
      </div>

      <!-- Notes Grid displaying all notes -->
      <div class="c-notes-grid">
        {% for note in collections.notes %}
          <article 
            class="c-note-card"
            x-show="activeFilter === 'all' || activeFilter === '{{ note.data.archetype }}'"
            {% if note.data.archetype %}
              :style="$store.compass.result && $store.compass.result === '{{ note.data.archetype }}' ? 'border-color: var(--color-muted-clay); background-color: var(--color-surface-container-low);' : ''"
            {% endif %}
          >
            <div class="c-note-card__header">
              <img 
                src="/assets/{{ note.data.archetype | archetypeIcon }}.svg" 
                alt="" 
                aria-hidden="true" 
                class="c-note-card__icon" 
                width="20" 
                height="20" 
              />
              <span>{{ note.data.archetype | archetypeTag }}</span>
            </div>
            
            <h2 class="c-note-card__title">
              <a href="{{ note.url }}" style="color: inherit; text-decoration: none;">
                {{ note.data.title }}
              </a>
            </h2>
            
            <p class="c-note-card__excerpt">{{ note.data.excerpt }}</p>

            <div class="u-font-mono u-text-muted" style="font-size: 0.75rem; margin-bottom: var(--space-md); text-transform: uppercase;">
              <time datetime="{{ note.date | htmlDateString }}">{{ note.date | readableDate }}</time>
            </div>
            
            <a href="{{ note.url }}" class="c-note-card__link" aria-label="Read note: {{ note.data.title }}">
              <span>Read the note</span>
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

