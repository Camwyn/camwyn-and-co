---
layout: base.njk
title: "Notes from the Field — Camwyn & Co"
description: "Dispatches, workbench notes, table stories, and collaborative experiments from Camwyn & Co."
permalink: "/notes/index.html"
---

<section 
  class="u-py-section" 
  aria-labelledby="notes-index-heading"
  x-data="{ 
    activeFilter: 'all', 
    userArchetype: null,
    searchQuery: '',
    archetypeNames: {
      gatherer: 'The Gatherer',
      craftsman: 'The Craftsman',
      explorer: 'The Explorer',
      catalyst: 'The Catalyst',
      storykeeper: 'The Storykeeper'
    },
    init() {
      try {
        const saved = (this.$store?.compass?.result || localStorage.getItem('compassResult') || '').toLowerCase();
        if (['gatherer', 'craftsman', 'explorer', 'catalyst', 'storykeeper'].includes(saved)) {
          this.userArchetype = saved;
          this.activeFilter = saved;
        }
      } catch (e) {}
    },
    matches(el, archetype) {
      const matchesArchetype = this.activeFilter === 'all' || this.activeFilter === archetype;
      if (!matchesArchetype) return false;
      if (!this.searchQuery || !this.searchQuery.trim()) return true;
      return el.textContent.toLowerCase().includes(this.searchQuery.toLowerCase().trim());
    }
  }"
>
  <div class="o-container o-container--wide">
    <div class="o-grid" style="align-items: end; margin-bottom: var(--space-xl);">
      <div style="grid-column: span 8;">
        <p class="c-hero__eyebrow">
          <span x-show="!activeFilter || activeFilter === 'all'">Around here lately</span>
          <span x-show="activeFilter && activeFilter !== 'all'" x-cloak>
            Showing dispatches tailored for <span class="u-text-clay-accessible" style="font-weight: 600;" x-text="archetypeNames[activeFilter] || activeFilter"></span>
            <template x-if="userArchetype && activeFilter === userArchetype">
              <span class="u-font-mono" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-left: 0.5rem; opacity: 0.85;">(Your Archetype)</span>
            </template>
          </span>
        </p>
        <h1 id="notes-index-heading" class="c-hero__title" style="font-size: clamp(2.5rem, 5vw, 4.25rem); margin-bottom: 0;">
          Notes<br>from<br>the field.
        </h1>
      </div>
      <div style="grid-column: span 4;">
        <p class="c-hero__lead" style="font-size: 1rem; border-top: 1px solid var(--color-outline-variant); padding-top: var(--space-md);">
          A living collection of things we're making, learning, tasting, and following. Dispatches from every perspective in our house of projects.
        </p>
      </div>
    </div>

    <!-- Controls Toolbar -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: var(--space-xl);">
      <!-- Archetype Filter Pills -->
      <div class="o-cluster" style="gap: 0.5rem;" role="group" aria-label="Filter notes by archetype">
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'all' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'all'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <span>All Notes ({{ collections.notes.length }})</span>
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'gatherer' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'gatherer'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <img src="/assets/leaf.svg" class="c-btn__icon" alt="" aria-hidden="true" width="14" height="14" />
          <span>The Gatherer</span>
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'craftsman' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'craftsman'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <img src="/assets/brush.svg" class="c-btn__icon" alt="" aria-hidden="true" width="14" height="14" />
          <span>The Craftsman</span>
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'explorer' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'explorer'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <img src="/assets/compass.svg" class="c-btn__icon" alt="" aria-hidden="true" width="14" height="14" />
          <span>The Explorer</span>
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'catalyst' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'catalyst'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <img src="/assets/wand.svg" class="c-btn__icon" alt="" aria-hidden="true" width="14" height="14" />
          <span>The Catalyst</span>
        </button>
        <button 
          type="button" 
          class="c-btn"
          :class="activeFilter === 'storykeeper' ? 'c-btn--primary' : 'c-btn--secondary'"
          @click="activeFilter = 'storykeeper'"
          style="padding: 0.375rem 0.875rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; min-height: 38px;"
        >
          <img src="/assets/shield.svg" class="c-btn__icon" alt="" aria-hidden="true" width="14" height="14" />
          <span>The Storykeeper</span>
        </button>
      </div>

      <!-- Search Input with Clear Button -->
      <div style="position: relative; min-width: 240px; flex-grow: 1; max-width: 320px;">
        <label for="notes-search-input" class="u-sr-only">Search field notes by title, topic, or keyword</label>
        <input 
          type="search" 
          id="notes-search-input"
          x-model="searchQuery" 
          placeholder="Search notes..." 
          aria-label="Search field notes by title, topic, or keyword"
          style="width: 100%; padding: 0.5rem 2rem 0.5rem 0.875rem; font-family: var(--font-sans); font-size: 0.875rem; border: 1px solid var(--color-outline-variant); background: var(--color-surface); color: var(--color-on-surface); border-radius: 0; box-sizing: border-box;"
        />
        <button 
          type="button" 
          x-show="searchQuery && searchQuery.length > 0" 
          @click="searchQuery = ''" 
          aria-label="Clear search query"
          style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.125rem; line-height: 1; cursor: pointer; color: var(--color-on-surface-variant); padding: 0.25rem;"
        >
          &times;
        </button>
      </div>
    </div>

    <!-- Notes Grid displaying all notes -->
    <div class="c-notes-grid">
      {% for note in collections.notes %}
        <article 
          class="c-note-card"
          x-show="matches($el, '{{ note.data.archetype }}')"
          {% if note.data.archetype %}
            :style="$store.compass.result && $store.compass.result === '{{ note.data.archetype }}' ? 'border-color: var(--color-muted-clay); background-color: var(--color-surface-container-low);' : ''"
          {% endif %}
        >
          <div class="c-note-card__header">
            <img 
              src="/assets/{{ note.data.archetype | archetypeIcon }}.svg" 
              alt="" 
              aria-hidden="true" 
              class="c-note-card__icon" 
              width="20" 
              height="20" 
            />
            <span>{{ note.data.archetype | archetypeTag }}</span>
          </div>
          
          <h2 class="c-note-card__title">
            <a href="{{ note.url }}" style="color: inherit; text-decoration: none;">
              {{ note.data.title }}
            </a>
          </h2>
          
          <p class="c-note-card__excerpt">{{ note.data.excerpt }}</p>

          <div class="u-font-mono u-text-muted" style="font-size: 0.75rem; margin-bottom: var(--space-md); text-transform: uppercase;">
            <time datetime="{{ note.date | htmlDateString }}">{{ note.date | readableDate }}</time>
          </div>
          
          <a href="{{ note.url }}" class="c-note-card__link" aria-label="Read note: {{ note.data.title }}">
            <span>Read the note</span>
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
