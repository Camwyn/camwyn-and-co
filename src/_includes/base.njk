<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle | default(title | default(site.name ~ " — " ~ site.tagline)) }}</title>
  <meta name="description" content="{{ description | default('Camwyn & Co is an independent house of projects, ventures, experiments, and worthwhile adventures.') }}">
  
  <!-- Open Graph & Social Cards -->
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{{ pageTitle | default(title | default(site.name ~ " — " ~ site.tagline)) }}">
  <meta property="og:description" content="{{ description | default('An independent house of projects, ventures, experiments, and worthwhile adventures.') }}">
  <meta property="og:url" content="{{ site.url ~ page.url }}">
  <meta property="og:image" content="{{ ogImage | default(site.url ~ '/assets/og/default.svg') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle | default(title | default(site.name ~ " — " ~ site.tagline)) }}">
  <meta name="twitter:description" content="{{ description | default('An independent house of projects, ventures, experiments, and worthwhile adventures.') }}">
  <meta name="twitter:image" content="{{ ogImage | default(site.url ~ '/assets/og/default.svg') }}">

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="canonical" href="{{ site.url ~ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Field Notes" href="{{ site.url }}/feed.xml">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- OCSS Architecture -->
  <link rel="stylesheet" href="/css/01-settings/tokens.css">
  <link rel="stylesheet" href="/css/02-objects/layout.css">
  <link rel="stylesheet" href="/css/02-objects/stack.css">
  <link rel="stylesheet" href="/css/03-components/nav.css">
  <link rel="stylesheet" href="/css/03-components/hero.css">
  <link rel="stylesheet" href="/css/03-components/compass.css">
  <link rel="stylesheet" href="/css/03-components/note-card.css">
  <link rel="stylesheet" href="/css/03-components/project-row.css">
  <link rel="stylesheet" href="/css/03-components/article.css">
  <link rel="stylesheet" href="/css/03-components/form.css">
  <link rel="stylesheet" href="/css/03-components/chemistry.css">
  <link rel="stylesheet" href="/css/03-components/footer.css">
  <link rel="stylesheet" href="/css/04-utilities/typography.css">
  <link rel="stylesheet" href="/css/04-utilities/spacing.css">
  <link rel="stylesheet" href="/css/04-utilities/print.css" media="print">

  <!-- Utilities & Alpine Store Init -->
  <script>
    window.copyToClipboard = function(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
        } catch (err) {
          console.error('Fallback copy failed', err);
        }
        document.body.removeChild(textArea);
        return Promise.resolve();
      }
    };

    document.addEventListener('alpine:init', () => {
      let initialResult = null;
      try {
        initialResult = localStorage.getItem('compassResult') || null;
      } catch (e) {}

      Alpine.store('compass', {
        step: initialResult ? 6 : 1,
        totalSteps: 5,
        answers: {},
        result: initialResult,
        
        // Questions and Archetypes matrices injected from JSON
        archetypes: {{ compass.archetypes | dump | safe }},
        questions: {{ compass.questions | dump | safe }},
        cta: {{ cta | dump | safe }},

        selectOption(questionId, archetype) {
          this.answers[questionId] = archetype;
          if (this.step < this.totalSteps) {
            this.step++;
          } else {
            this.calculateResult();
          }
        },

        calculateResult() {
          const counts = {};
          Object.values(this.answers).forEach(arch => {
            counts[arch] = (counts[arch] || 0) + 1;
          });
          const topArchetype = Object.keys(counts).reduce((a, b) => (counts[a] >= counts[b] ? a : b), 'explorer');
          this.result = topArchetype;
          try {
            localStorage.setItem('compassResult', topArchetype);
          } catch (e) {}
          this.step = 6;
        },

        setArchetype(archKey) {
          if (this.archetypes && this.archetypes[archKey]) {
            this.result = archKey;
            this.step = 6;
            try {
              localStorage.setItem('compassResult', archKey);
            } catch (e) {}
          }
        },

        reset() {
          this.step = 1;
          this.answers = {};
          this.result = null;
          try {
            localStorage.removeItem('compassResult');
          } catch (e) {}
        }
      });
    });
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/persist@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body x-data>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="c-skip-link">Skip to main content</a>

  <!-- Navigation -->
  {% include "sidenav.njk" %}

  <!-- Main Canvas -->
  <div class="o-canvas">
    <main id="main-content">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}
  </div>
</body>
</html>