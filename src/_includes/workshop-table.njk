<!-- Workshop Table & Archetype Chemistry Grid -->
<script>
  window.__CHEMISTRY_PAIRINGS__ = {{ chemistry.pairings | dump | safe }};
</script>

<section 
  class="c-chemistry-section" 
  id="workshop-table" 
  aria-labelledby="workshop-table-heading"
  x-data="{
    archetypeA: 'craftsman',
    archetypeB: 'gatherer',
    activeFilter: 'all',
    userArchetype: null,
    pairings: window.__CHEMISTRY_PAIRINGS__ || {},
    archetypeNames: {
      gatherer: 'The Gatherer',
      craftsman: 'The Craftsman',
      explorer: 'The Explorer',
      catalyst: 'The Catalyst',
      storykeeper: 'The Storykeeper'
    },
    archetypeIcons: {
      gatherer: 'leaf',
      craftsman: 'brush',
      explorer: 'compass',
      catalyst: 'wand',
      storykeeper: 'shield'
    },
    getCanonicalKey(a, b) {
      const sorted = [a, b].sort();
      return sorted[0] + '+' + sorted[1];
    },
    get currentPairing() {
      const key = this.getCanonicalKey(this.archetypeA, this.archetypeB);
      return (this.pairings && this.pairings[key]) ? this.pairings[key] : (this.pairings ? this.pairings['craftsman+gatherer'] : {});
    },
    selectDuo(a, b) {
      this.archetypeA = a;
      this.archetypeB = b;
    },
    init() {
      try {
        const saved = (this.$store?.compass?.result || localStorage.getItem('compassResult') || '').toLowerCase();
        if (['gatherer', 'craftsman', 'explorer', 'catalyst', 'storykeeper'].includes(saved)) {
          this.userArchetype = saved;
          this.archetypeA = saved;
          this.archetypeB = saved === 'craftsman' ? 'gatherer' : (saved === 'gatherer' ? 'craftsman' : 'craftsman');
          this.activeFilter = 'user';
        }
      } catch (e) {}
    },
    matchesFilter(archA, archB, isDouble) {
      if (this.activeFilter === 'all') return true;
      if (this.activeFilter === 'doubles') return isDouble;
      if (this.activeFilter === 'user') {
        if (!this.userArchetype) return true;
        return archA === this.userArchetype || archB === this.userArchetype;
      }
      return archA === this.activeFilter || archB === this.activeFilter;
    }
  }"
>
  <div class="o-container o-container--wide">
    <div class="c-chemistry-intro">
      <p class="c-hero__eyebrow">The Collaborative Equation</p>
      <h2 id="workshop-table-heading" class="u-font-serif" style="font-size: clamp(2.25rem, 5vw, 3.5rem); color: var(--color-primary); margin-bottom: var(--space-sm);">
        At the Workshop Table
      </h2>
      <p style="font-size: 1.125rem; line-height: 1.7; color: var(--color-on-surface-variant); max-width: 48rem;">
        Every worthwhile adventure requires more than one perspective. Explore the collaborative chemistry when two distinct instincts sit side by side—how they spark, where they friction, and the enduring things they build together.
      </p>
    </div>

    <!-- Interactive Duo Builder & Result Card -->
    <div class="c-chemistry-interactive">
      <!-- Selector Panel -->
      <div class="c-chemistry-builder">
        <h3 class="u-font-serif" style="font-size: 1.5rem; color: var(--color-primary); margin-bottom: var(--space-md);">
          Pair Any Two Instincts
        </h3>

        <!-- Person 1 Selector -->
        <div class="c-chemistry-picker-group">
          <span class="c-chemistry-picker-label">
            First Instinct (e.g. You)
            <template x-if="userArchetype">
              <span style="color: var(--color-muted-clay-text); text-transform: none; margin-left: 0.25rem;">(Active Compass detected)</span>
            </template>
          </span>
          <div class="c-chemistry-pills" role="group" aria-label="Select first archetype">
            {% for key, arch in compass.archetypes %}
              <button 
                type="button" 
                class="c-chemistry-pill" 
                :class="{ 'is-active': archetypeA === '{{ key }}' }"
                @click="archetypeA = '{{ key }}'"
                :aria-pressed="archetypeA === '{{ key }}'"
                aria-pressed="false"
              >
                <img src="/assets/{{ arch.icon }}.svg" alt="" aria-hidden="true" class="c-chemistry-pill__icon" width="14" height="14" />
                <span>{{ arch.name }}</span>
              </button>
            {% endfor %}
          </div>
        </div>

        <!-- Person 2 Selector -->
        <div class="c-chemistry-picker-group">
          <span class="c-chemistry-picker-label">Second Instinct (Collaborator)</span>
          <div class="c-chemistry-pills" role="group" aria-label="Select collaborator archetype">
            {% for key, arch in compass.archetypes %}
              <button 
                type="button" 
                class="c-chemistry-pill" 
                :class="{ 'is-active': archetypeB === '{{ key }}' }"
                @click="archetypeB = '{{ key }}'"
                :aria-pressed="archetypeB === '{{ key }}'"
                aria-pressed="false"
              >
                <img src="/assets/{{ arch.icon }}.svg" alt="" aria-hidden="true" class="c-chemistry-pill__icon" width="14" height="14" />
                <span>{{ arch.name }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Featured Chemistry Profile -->
      <div class="c-chemistry-hero-card" aria-live="polite">
        <div class="c-chemistry-hero-card__header">
          <div class="c-chemistry-hero-card__duo-icons">
            <div class="c-chemistry-hero-card__icon-badge">
              <img :src="'/assets/' + (archetypeIcons[currentPairing.archetypeA] || 'brush') + '.svg'" alt="" aria-hidden="true" width="16" height="16" />
              <span x-text="archetypeNames[currentPairing.archetypeA] || 'The Craftsman'">The Craftsman</span>
            </div>
            <span class="c-chemistry-hero-card__plus">+</span>
            <div class="c-chemistry-hero-card__icon-badge">
              <img :src="'/assets/' + (archetypeIcons[currentPairing.archetypeB] || 'leaf') + '.svg'" alt="" aria-hidden="true" width="16" height="16" />
              <span x-text="archetypeNames[currentPairing.archetypeB] || 'The Gatherer'">The Gatherer</span>
            </div>
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.375rem;">
            <template x-if="currentPairing.isDouble">
              <img src="/assets/star.svg" alt="" aria-hidden="true" width="12" height="12" />
            </template>
            <span class="u-font-mono u-text-uppercase" style="font-size: 0.6875rem; color: var(--color-muted-clay-text);" x-text="currentPairing.isDouble ? 'Double Synergy' : 'Reciprocal Chemistry'">Reciprocal Chemistry</span>
          </div>
        </div>

        <h3 class="c-chemistry-hero-card__title" x-text="currentPairing.title || 'The Kitchen Table'">The Kitchen Table</h3>
        <p class="c-chemistry-hero-card__tagline" x-text="currentPairing.tagline || 'Carefully built environments designed for generous living.'">Carefully built environments designed for generous living.</p>
        <p class="c-chemistry-hero-card__body" x-text="currentPairing.chemistry || 'The core founding chemistry of Camwyn & Co. Stephen builds the sturdy white-oak table; Ivy fills it with food, laughter, and open conversation. Structural integrity meets deep human connection.'">The core founding chemistry of Camwyn &amp; Co. Stephen builds the sturdy white-oak table; Ivy fills it with food, laughter, and open conversation. Structural integrity meets deep human connection.</p>

        <div class="c-chemistry-hero-card__insights">
          <div class="c-chemistry-insight-box">
            <span class="c-chemistry-insight-box__label" style="display: flex; align-items: center; gap: 0.375rem;">
              <img src="/assets/bolt.svg" alt="" aria-hidden="true" width="12" height="12" />
              <span>Where Friction Sparks</span>
            </span>
            <p class="c-chemistry-insight-box__text" x-text="currentPairing.watchOut || 'The Craftsman may retreat into the workshop when the house gets full; the Gatherer must remember to protect the Craftsman\'s quiet making hours.'">The Craftsman may retreat into the workshop when the house gets full; the Gatherer must remember to protect the Craftsman's quiet making hours.</p>
          </div>
          <div class="c-chemistry-insight-box">
            <span class="c-chemistry-insight-box__label" style="display: flex; align-items: center; gap: 0.375rem;">
              <img src="/assets/star.svg" alt="" aria-hidden="true" width="12" height="12" />
              <span>Sweet Spot &amp; Venture Fit</span>
            </span>
            <p class="c-chemistry-insight-box__text" x-text="currentPairing.idealProject || 'Hospitality spaces, heirloom workshops, family ventures, and atelier studios.'">Hospitality spaces, heirloom workshops, family ventures, and atelier studios.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Complete 15-Pairing Catalog Grid -->
    <div class="c-chemistry-catalog">
      <div class="c-chemistry-catalog-header">
        <div>
          <h3 class="u-font-serif" style="font-size: 1.75rem; color: var(--color-primary); margin-bottom: 0.25rem;">
            Explore All 15 Combinations
          </h3>
          <p style="font-size: 0.9375rem; color: var(--color-on-surface-variant);">
            Click any pairing card below to load its full collaborative spec.
          </p>
        </div>

        <!-- Filter Controls -->
        <div class="o-cluster" style="gap: 0.5rem; flex-wrap: wrap;" role="group" aria-label="Filter chemistry pairings">
          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'all' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'all'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <span>All 15</span>
          </button>
          
          <template x-if="userArchetype">
            <button 
              type="button" 
              class="c-btn"
              :class="activeFilter === 'user' ? 'c-btn--primary' : 'c-btn--secondary'"
              @click="activeFilter = 'user'"
              style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
            >
              <span>My Pairings (5)</span>
            </button>
          </template>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'doubles' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'doubles'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <span>Doubles (5)</span>
          </button>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'craftsman' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'craftsman'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <img src="/assets/brush.svg" class="c-btn__icon" alt="" aria-hidden="true" width="12" height="12" />
            <span>Craftsman</span>
          </button>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'gatherer' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'gatherer'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <img src="/assets/leaf.svg" class="c-btn__icon" alt="" aria-hidden="true" width="12" height="12" />
            <span>Gatherer</span>
          </button>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'explorer' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'explorer'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <img src="/assets/compass.svg" class="c-btn__icon" alt="" aria-hidden="true" width="12" height="12" />
            <span>Explorer</span>
          </button>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'catalyst' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'catalyst'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <img src="/assets/wand.svg" class="c-btn__icon" alt="" aria-hidden="true" width="12" height="12" />
            <span>Catalyst</span>
          </button>

          <button 
            type="button" 
            class="c-btn"
            :class="activeFilter === 'storykeeper' ? 'c-btn--primary' : 'c-btn--secondary'"
            @click="activeFilter = 'storykeeper'"
            style="padding: 0.375rem 0.75rem; font-size: 0.6875rem; min-height: 36px;"
          >
            <img src="/assets/shield.svg" class="c-btn__icon" alt="" aria-hidden="true" width="12" height="12" />
            <span>Storykeeper</span>
          </button>
        </div>
      </div>

      <div class="c-chemistry-grid">
        {% for key, pair in chemistry.pairings %}
          <div 
            class="c-chemistry-card"
            :class="{
              'is-active': getCanonicalKey(archetypeA, archetypeB) === '{{ key }}',
              'c-chemistry-card--user-promoted': userArchetype && ('{{ pair.archetypeA }}' === userArchetype || '{{ pair.archetypeB }}' === userArchetype)
            }"
            x-show="matchesFilter('{{ pair.archetypeA }}', '{{ pair.archetypeB }}', {{ 'true' if pair.isDouble else 'false' }})"
            @click="selectDuo('{{ pair.archetypeA }}', '{{ pair.archetypeB }}'); document.getElementById('workshop-table').scrollIntoView({ behavior: 'smooth', block: 'start' });"
            role="button"
            tabindex="0"
            @keydown.enter="selectDuo('{{ pair.archetypeA }}', '{{ pair.archetypeB }}'); document.getElementById('workshop-table').scrollIntoView({ behavior: 'smooth', block: 'start' });"
            @keydown.space.prevent="selectDuo('{{ pair.archetypeA }}', '{{ pair.archetypeB }}'); document.getElementById('workshop-table').scrollIntoView({ behavior: 'smooth', block: 'start' });"
            aria-label="Explore chemistry for {{ pair.title }}"
          >
            <div>
              <div class="c-chemistry-card__badge" x-show="userArchetype && ('{{ pair.archetypeA }}' === userArchetype || '{{ pair.archetypeB }}' === userArchetype)">
                <img src="/assets/compass.svg" alt="" aria-hidden="true" width="12" height="12" />
                <span>Resonates with Your Compass</span>
              </div>
              <div class="c-chemistry-card__duo">
                <img src="/assets/{{ compass.archetypes[pair.archetypeA].icon }}.svg" alt="" aria-hidden="true" width="16" height="16" />
                <span class="u-font-mono" style="font-size: 0.75rem;">{{ compass.archetypes[pair.archetypeA].name }}</span>
                <span class="u-font-mono" style="font-size: 0.75rem; color: var(--color-muted-clay-text);">+</span>
                <img src="/assets/{{ compass.archetypes[pair.archetypeB].icon }}.svg" alt="" aria-hidden="true" width="16" height="16" />
                <span class="u-font-mono" style="font-size: 0.75rem;">{{ compass.archetypes[pair.archetypeB].name }}</span>
              </div>
              <h4 class="c-chemistry-card__title">{{ pair.title }}</h4>
              <p class="c-chemistry-card__tagline">{{ pair.tagline }}</p>
            </div>
            <div class="c-chemistry-card__footer">
              <span>{{ 'Double Synergy' if pair.isDouble else 'Reciprocal Duo' }}</span>
              <span>Inspect Specimen →</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
