<!-- CTA Section / Pull up a chair -->
<section class="c-cta-section" id="say-hello" aria-labelledby="cta-heading">
  <div class="o-container o-container--wide">
    <div class="c-cta-layout">
      <div>
        <p class="c-hero__eyebrow">Pull up a chair</p>
        <h2 id="cta-heading" class="c-cta__title">
          Let's see<br>where<br>this leads.
        </h2>
      </div>
      <div class="o-stack" style="align-items: flex-start;">
        <p class="c-hero__lead" style="font-size: 1.125rem;">
          For new projects, unexpected collaborations, or simply a good conversation.
        </p>
        <a href="mailto:{{ site.contactEmail }}" class="c-btn c-btn--primary" style="font-size: 0.875rem; padding: 1rem 2rem;">
          {{ site.contactEmail }} ↗
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Footer Colophon -->
<footer class="c-footer">
  <div>
    <span>&copy; {{ site.year }} {{ site.name }}</span>
  </div>
  <div>
    <span>Made with care, wherever we are.</span>
  </div>
  <div class="c-footer__links">
    <a href="/notes/" class="c-footer__link">Field Notes</a>
    <a href="#" class="c-footer__link">Privacy</a>
    <a href="#" class="c-footer__link">Terms</a>
    <a href="#main-content" class="c-footer__link">Back to Top ↑</a>
  </div>
</footer>

