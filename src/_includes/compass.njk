<section class="c-compass-section" id="your-compass" aria-labelledby="compass-heading">
  <div class="o-container o-container--wide">
    <div class="c-compass-layout">
      <!-- Left Intro -->
      <div>
        <p class="c-compass__intro-eyebrow">A small detour</p>
        <h2 id="compass-heading" class="c-compass__intro-title">
          Find your<br>
          <span class="u-text-clay">adventure<br>compass.</span>
        </h2>
        <p class="c-compass__intro-desc">
          Five questions. No wrong turns. Discover what you naturally bring to the next worthwhile adventure.
        </p>
      </div>

      <!-- Right Interactive Quiz Card -->
      <div class="c-compass-card" x-data aria-live="polite">
        <div class="c-compass-card__top-bar"></div>

        <!-- Questions View (Pre-rendered via Nunjucks with Alpine x-show toggles) -->
        {% for q in compass.questions %}
          <div 
            x-show="!$store.compass.result && $store.compass.step === {{ q.id }}"
            {% if q.id != 1 %}style="display: none;"{% endif %}
          >
            <div class="c-compass-card__meta">
              <span>Question {{ q.id }} of {{ compass.questions | length }}</span>
              <span class="u-font-mono">{{ q.number }}</span>
            </div>

            <h3 class="c-compass-card__prompt">{{ q.prompt }}</h3>

            <div class="c-compass-options" role="group" aria-label="Options for question {{ q.id }}">
              {% for opt in q.options %}
                <button 
                  type="button"
                  class="c-compass-option"
                  @click="$store.compass.selectOption({{ q.id }}, '{{ opt.archetype }}')"
                >
                  <span>{{ opt.text }}</span>
                  <span class="c-compass-option__icon" aria-hidden="true">↗</span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <!-- Result View (Step 6 / Persisted Result) -->
        <div x-show="$store.compass.result || $store.compass.step === 6" style="display: none;" x-cloak>
          <div class="c-compass-result">
            <span class="c-compass-result__badge">Your adventure compass points to</span>
            <img 
              class="c-compass-result__icon" 
              :src="$store.compass.archetypes[$store.compass.result] ? '/assets/' + $store.compass.archetypes[$store.compass.result].icon + '.svg' : '/assets/compass.svg'" 
              :alt="$store.compass.archetypes[$store.compass.result] ? $store.compass.archetypes[$store.compass.result].name + ' icon' : 'Compass icon'"
              width="100"
              height="100"
            />
            <h3 class="c-compass-result__name" x-text="$store.compass.archetypes[$store.compass.result] ? $store.compass.archetypes[$store.compass.result].name : ''"></h3>
            <p class="c-compass-result__tagline" x-text="$store.compass.archetypes[$store.compass.result] ? $store.compass.archetypes[$store.compass.result].tagline : ''"></p>
            <p class="c-compass-result__desc" x-text="$store.compass.archetypes[$store.compass.result] ? $store.compass.archetypes[$store.compass.result].description : ''"></p>

            <div class="c-compass-result__prompt" x-show="$store.compass.archetypes[$store.compass.result] && $store.compass.archetypes[$store.compass.result].lifePrompt">
              <span class="c-compass-result__prompt-title">Your next small adventure</span>
              <p class="c-compass-result__prompt-text" x-text="$store.compass.archetypes[$store.compass.result] ? $store.compass.archetypes[$store.compass.result].lifePrompt : ''"></p>
            </div>
            
            <div class="u-border-top u-pt-sm u-mt-md">
              <p class="u-font-mono u-text-muted" style="font-size: 0.8125rem;" x-text="$store.compass.archetypes[$store.compass.result] ? 'Field Recommendation: ' + $store.compass.archetypes[$store.compass.result].fieldPrompt : ''"></p>
            </div>

            <!-- Social Share Bar -->
            <div class="c-compass-share-group u-border-top u-pt-sm u-mt-sm" x-data="{ copied: false }">
              <span class="u-font-mono u-text-uppercase" style="font-size: 0.6875rem; letter-spacing: 0.1em; color: var(--color-muted-clay-text);">Share your result</span>
              <div class="o-cluster" style="gap: 0.5rem; margin-top: 0.35rem; flex-wrap: wrap;">
                <!-- Native Web Share API -->
                <button 
                  type="button" 
                  class="c-btn c-btn--secondary"
                  style="padding: 0.5rem 0.875rem; font-size: 0.6875rem; min-height: 38px;"
                  x-show="'share' in navigator"
                  @click="
                    navigator.share({
                      title: 'My Adventure Compass: ' + ($store.compass.archetypes[$store.compass.result]?.name || ''),
                      text: $store.compass.archetypes[$store.compass.result]?.tagline || '',
                      url: '{{ site.url }}/compass/' + $store.compass.result + '/'
                    }).catch(() => {})
                  "
                >
                  Share ↗
                </button>

                <!-- Facebook Direct Share -->
                <a 
                  :href="'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent('{{ site.url }}/compass/' + $store.compass.result + '/')" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="c-btn c-btn--secondary"
                  style="padding: 0.5rem 0.875rem; font-size: 0.6875rem; min-height: 38px;"
                  aria-label="Share result on Facebook"
                >
                  Facebook ↗
                </a>

                <!-- Copy Link Button -->
                <button 
                  type="button" 
                  class="c-btn c-btn--secondary"
                  style="padding: 0.5rem 0.875rem; font-size: 0.6875rem; min-height: 38px;"
                  @click="
                    navigator.clipboard.writeText('{{ site.url }}/compass/' + $store.compass.result + '/');
                    copied = true;
                    setTimeout(() => copied = false, 2500);
                  "
                >
                  <span x-text="copied ? '✓ Copied!' : 'Copy Link'">Copy Link</span>
                </button>
              </div>
            </div>

            <div class="c-compass-result__action">
              <a href="#notes-from-the-field" class="c-btn c-btn--primary">Explore Recommended Notes ↗</a>
              <button type="button" class="c-btn c-btn--secondary" @click="$store.compass.reset()">Retake Compass</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
