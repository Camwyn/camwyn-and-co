<!-- CTA Section / Pull up a chair -->
<section class="c-cta-section" id="say-hello" aria-labelledby="cta-heading">
  <div class="o-container o-container--wide">
    <div class="c-cta-layout">
      <div>
        <p class="c-hero__eyebrow" x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).eyebrow">
          {{ cta.default.eyebrow }}
        </p>
        <h2 id="cta-heading" class="c-cta__title" x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).heading">
          Let's see<br>where<br>this leads.
        </h2>
      </div>
      <div class="o-stack" style="align-items: flex-start;">
        <p class="c-hero__lead" style="font-size: 1.125rem;" x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).lead">
          {{ cta.default.lead }}
        </p>
        <a href="/the-next-thing/" class="c-btn c-btn--primary" style="font-size: 0.875rem; padding: 1rem 2rem;">
          <img src="/assets/wand.svg" class="c-btn__icon" alt="" aria-hidden="true" width="16" height="16" />
          <span x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).buttonText">{{ cta.default.buttonText }}</span>
        </a>
      </div>
    </div>
  </div>
</section>
