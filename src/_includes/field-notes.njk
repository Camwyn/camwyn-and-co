<section class="u-py-section" id="notes-from-the-field" aria-labelledby="notes-heading">
  <div class="o-container o-container--wide">
    <div class="o-grid" style="align-items: end; margin-bottom: var(--space-xl);">
      <div class="o-grid__col--8">
        <p class="c-hero__eyebrow">Around here lately</p>
        <h2 id="notes-heading" class="c-hero__title" style="font-size: clamp(2.25rem, 5vw, 4rem); margin-bottom: 0;">
          Notes<br>from<br>the field.
        </h2>
      </div>
      <div class="o-grid__col--4">
        <p class="c-hero__lead" style="font-size: 1rem; border-top: 1px solid var(--color-outline-variant); padding-top: var(--space-md);">
          A living collection of things we're making, learning, tasting, and following. Small dispatches from a company that refuses to sit still.
        </p>
      </div>
    </div>

    <!-- Notes Grid with Pre-rendered HTML and Alpine dynamic filtering -->
    <div class="c-notes-grid" x-data>
      {% for note in collections.latestNotesByArchetype %}
        <article 
          class="c-note-card"
          {% if note.data.archetype %}
            :style="$store.compass.result && $store.compass.result === '{{ note.data.archetype }}' ? 'border-color: var(--color-muted-clay); background-color: var(--color-surface-container-low);' : ''"
          {% endif %}
        >
          <div class="c-note-card__header">
            <img 
              src="/assets/{{ note.data.archetype | archetypeIcon }}.svg" 
              alt="" 
              aria-hidden="true" 
              class="c-note-card__icon" 
              width="20" 
              height="20" 
            />
            <span>{{ note.data.archetype | archetypeTag }}</span>
          </div>
          <h3 class="c-note-card__title">{{ note.data.title }}</h3>
          <p class="c-note-card__excerpt">{{ note.data.excerpt }}</p>
          <a href="{{ note.url }}" class="c-note-card__link" aria-label="Read note: {{ note.data.title }}">
            <span>Read the note</span>
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      {% endfor %}
    </div>

    <div style="margin-top: var(--space-xl); display: flex; justify-content: flex-end;">
      <a href="/notes/" class="c-btn c-btn--secondary" style="padding: 0.75rem 1.25rem; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em;">
        <span>View all notes</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

