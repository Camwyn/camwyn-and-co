<!-- Desktop Sidenav -->
<aside class="c-sidenav" aria-label="Main Navigation">
  <div class="c-sidenav__header">
    <a href="/" class="c-sidenav__brand-link" aria-label="{{ site.name }} homepage">
      <img src="/assets/logo.svg" alt="{{ site.name }}" class="c-sidenav__logo" width="150" height="108">
    </a>
    <p class="c-sidenav__tagline">{{ site.subtagline }}</p>
  </div>

  <nav class="c-sidenav__list">
    {% for item in site.nav %}
      <div class="c-sidenav__item">
        {% if item.num == "02" %}
          <!-- Dynamic In-Place Compass Navigation Link -->
          <a 
            :href="$store.compass.result ? ('/compass/' + $store.compass.result + '/') : '{{ item.url }}'" 
            href="{{ item.url }}" 
            class="c-nav-link{% if page.url == item.url %} is-active{% endif %}"
            :class="{ 'is-active': $store.compass.result && page.url === ('/compass/' + $store.compass.result + '/') }"
            :title="$store.compass.result ? ('View your ' + ($store.compass.archetypes[$store.compass.result]?.name || 'Compass') + ' profile') : 'Find your creative archetype'"
          >
            <img 
              class="c-nav-link__icon" 
              :src="'/assets/' + ($store.compass.archetypes[$store.compass.result]?.icon || '{{ item.icon }}') + '.svg'" 
              src="/assets/{{ item.icon }}.svg" 
              alt="" 
              aria-hidden="true" 
              width="16" 
              height="16" 
            />
            <span 
              class="c-nav-link__label" 
              x-text="$store.compass.result ? ('Compass: ' + ($store.compass.archetypes[$store.compass.result]?.name || '{{ item.label }}')) : '{{ item.label }}'"
            >{{ item.label }}</span>
          </a>
        {% else %}
          <a href="{{ item.url }}" class="c-nav-link{% if page.url == item.url %} is-active{% endif %}">
            <img class="c-nav-link__icon" src="/assets/{{ item.icon }}.svg" alt="" aria-hidden="true" width="16" height="16" />
            <span class="c-nav-link__label">{{ item.label }}</span>
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </nav>

  <div class="c-sidenav__footer">
    <p>One roof.<br>Many paths.<br>Plenty of room.</p>
  </div>
</aside>

<!-- Mobile Navigation Header -->
<header class="c-mobile-nav" aria-label="Mobile Navigation">
  <a href="/" class="c-sidenav__brand-link" aria-label="{{ site.name }} homepage">
    <img src="/assets/logo.svg" alt="{{ site.name }}" class="c-mobile-nav__logo" width="100" height="72">
  </a>
  <div class="o-cluster" style="gap: 0.75rem; align-items: center;">
    {% for item in site.nav %}
      {% if item.num == "02" %}
        <a 
          :href="$store.compass.result ? ('/compass/' + $store.compass.result + '/') : '{{ item.url }}'" 
          href="{{ item.url }}"
          class="c-nav-link__label" 
          style="text-decoration: none; color: var(--color-primary); font-weight: 500;"
          x-text="$store.compass.result ? ($store.compass.archetypes[$store.compass.result]?.name || '{{ item.label }}') : '{{ item.label }}'"
        >{{ item.label }}</a>
      {% else %}
        <a href="{{ item.url }}" class="c-nav-link__label" style="text-decoration: none; color: var(--color-primary);">{{ item.label }}</a>
      {% endif %}
    {% endfor %}
  </div>
</header>
