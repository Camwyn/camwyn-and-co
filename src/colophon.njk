    <!-- Section 1: The Engineering Stack -->
    <div style="margin-bottom: var(--space-xxl); padding-top: var(--space-xl); border-top: 1px solid var(--color-outline-variant);">
      <div class="c-colophon-section-header">
        <div>
          <p class="c-hero__eyebrow">Foundation &amp; Runtime</p>
          <h2 id="engineering-stack" class="u-font-serif" style="font-size: 2rem; font-weight: 400; color: var(--color-primary);">
            The Engineering Stack
          </h2>
        </div>
        <div>
          <p style="font-size: 1.125rem; line-height: 1.7; color: var(--color-on-surface-variant);">
            We believe the best software is resilient, fast, and unburdened by unnecessary complexity. There are no client-side single-page framework hydration waterfalls, no bloated bundles, and zero tracking scripts.
          </p>
        </div>
      </div>

      <div class="c-specimen-grid">
        <!-- Eleventy Card -->
        <div class="c-specimen-card c-specimen-card--alt">
          <div class="u-font-mono u-text-clay-accessible" style="font-size: 0.75rem; text-transform: uppercase; margin-bottom: var(--space-xs);">Static Engine</div>
          <h3 class="u-font-serif" style="font-size: 1.375rem; font-weight: 400; margin-bottom: var(--space-sm); color: var(--color-primary);">
            <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline; text-decoration-color: var(--color-muted-clay);">Eleventy (11ty) ↗</a>
          </h3>
          <p style="font-size: 0.9375rem; line-height: 1.6; color: var(--color-on-surface-variant);">
            A zero-config-lockin static site generator transforming Nunjucks templates and Markdown into pure, blazing-fast HTML without any runtime server footprint.
          </p>
        </div>

        <!-- Alpine.js Card -->
        <div class="c-specimen-card c-specimen-card--alt">
          <div class="u-font-mono u-text-clay-accessible" style="font-size: 0.75rem; text-transform: uppercase; margin-bottom: var(--space-xs);">Progressive State</div>
          <h3 class="u-font-serif" style="font-size: 1.375rem; font-weight: 400; margin-bottom: var(--space-sm); color: var(--color-primary);">
            <a href="https://alpinejs.dev/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline; text-decoration-color: var(--color-muted-clay);">Alpine.js ↗</a>
          </h3>
          <p style="font-size: 0.9375rem; line-height: 1.6; color: var(--color-on-surface-variant);">
            Minimal, declarative reactivity used selectively for progressive enhancement: the Adventure Compass quiz engine, real-time archive search, and persistent archetype tailoring.
          </p>
        </div>

        <!-- Pure OCSS Card -->
        <div class="c-specimen-card c-specimen-card--alt">
          <div class="u-font-mono u-text-clay-accessible" style="font-size: 0.75rem; text-transform: uppercase; margin-bottom: var(--space-xs);">Architecture</div>
          <h3 class="u-font-serif" style="font-size: 1.375rem; font-weight: 400; margin-bottom: var(--space-sm); color: var(--color-primary);">Pure OCSS</h3>
          <p style="font-size: 0.9375rem; line-height: 1.6; color: var(--color-on-surface-variant);">
            An inverted triangle design system (Tokens &rarr; Objects &rarr; Components &rarr; Utilities) authored in modern, semantic CSS with CSS custom properties and zero utility bloat.
          </p>
        </div>
      </div>
