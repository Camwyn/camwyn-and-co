---
layout: base.njk
title: "The Next Thing — Start a Project with Camwyn & Co"
description: "A permanent open door for worthwhile adventures. Tell us about your project, your natural archetype, and the complementary energy you need."
permalink: "/the-next-thing/index.html"
hideCta: true
---

<div x-data="{
  myArchetype: $store.compass.result || '',
  neededArchetype: 'open',
  stage: 'sketch',
  name: '',
  email: '',
  projectTitle: '',
  spark: '',
  support: '',
  isSubmitting: false,
  errorMessage: '',
  submitted: false,
  async submitForm() {
    if (!this.name || !this.email || !this.spark) return;
    this.isSubmitting = true;
    this.errorMessage = '';

    const payload = {
      name: this.name,
      email: this.email,
      project_title: this.projectTitle || 'Untitled Adventure',
      my_archetype: this.myArchetype ? (this.$store?.compass?.archetypes?.[this.myArchetype]?.name || this.myArchetype) : 'Still Exploring',
      needed_archetype: this.neededArchetype === 'open' ? 'A Mix / Open Exploration' : (this.$store?.compass?.archetypes?.[this.neededArchetype]?.name || this.neededArchetype),
      project_stage: this.stage,
      spark: this.spark,
      support_needed: this.support || 'N/A'
    };

    const endpoint = '{{ site.formspreeEndpoint | default('https://formspree.io/f/placeholder') }}';

    // Fallback for placeholder endpoint: allow instant preview success
    if (!endpoint || endpoint.includes('placeholder')) {
      this.submitted = true;
      this.isSubmitting = false;
      this.$nextTick(() => {
        document.getElementById('dispatch-received')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      return;
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        this.submitted = true;
        this.$nextTick(() => {
          document.getElementById('dispatch-received')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      } else {
        const data = await response.json().catch(() => ({}));
        if (data.errors && data.errors.length) {
          this.errorMessage = data.errors.map(e => e.message).join(', ');
        } else {
          this.errorMessage = 'There was a problem submitting your dispatch. Please try again or email {{ site.supportEmail }} directly.';
        }
      }
    } catch (err) {
      this.errorMessage = 'Network error sending your dispatch. Please check your connection or email {{ site.supportEmail }} directly.';
    } finally {
      this.isSubmitting = false;
    }
  },
  resetForm() {
    this.name = '';
    this.email = '';
    this.projectTitle = '';
    this.spark = '';
    this.support = '';
    this.stage = 'sketch';
    this.submitted = false;
    this.errorMessage = '';
    this.$nextTick(() => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
}">
  <!-- Header / Intro Section (Paper White) -->
  <section class="c-form-hero" aria-labelledby="form-heading">
    <div class="o-container c-form-container">
      <!-- Breadcrumb -->
      <div style="margin-bottom: var(--space-lg);">
        <a href="/" class="c-hero__anchor" style="font-size: 0.8125rem;">
          ← Back to Camwyn &amp; Co
        </a>
      </div>

      <!-- Header -->
      <header class="c-form-header" x-show="!submitted">
        <p class="u-font-mono u-text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.1em; color: var(--color-muted-clay-text); margin-bottom: var(--space-sm);">
          Experiments · Possibility · The Next Thing
        </p>
        <h1 id="form-heading" class="c-form-title">
          Tell us about<br>
          <span class="u-text-clay">the spark.</span>
        </h1>
        <p class="c-form-intro">
          A permanent open door for the worthwhile adventures we haven't met yet. Whether it's a sketch in a notebook or a venture ready for its next chapter, tell us about what you're making.
        </p>
      </header>

      <!-- Direct Email / Open Thread Prompt -->
      <div class="c-form-alt-prompt" x-show="!submitted">
        <p style="margin: 0;">
          <span x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).openThreadPrefix">{{ cta.default.openThreadPrefix }}</span><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a><span x-text="($store.compass.cta[$store.compass.result] || $store.compass.cta.default).openThreadSuffix">{{ cta.default.openThreadSuffix }}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- The Form Section (Warm Sand) -->
  <section class="c-form-section u-bg-warm-sand" aria-label="Project dispatch form">
    <div class="o-container c-form-container u-bg-warm-sand">
      <!-- Success Screen (Shown after submission) -->
      <div 
        id="dispatch-received"
        class="c-form-success" 
        x-show="submitted" 
        style="display: none;" 
        x-cloak
        tabindex="-1"
        aria-live="polite"
      >
      <p class="c-form-success__badge">Dispatch Received</p>
      <h2 class="c-form-success__title">Pull up a chair. We've got your note.</h2>
      <p class="c-form-success__message">
        Thank you, <strong x-text="name"></strong>. We read every project dispatch with care and unhurried attention.
      </p>

      <div class="c-form-success__summary o-stack" style="gap: var(--space-sm);">
        <p class="u-font-mono u-text-uppercase" style="font-size: 0.75rem; color: var(--color-muted-clay-text);">Project Summary</p>
        <p><strong class="u-font-serif" style="font-size: 1.25rem;" x-text="projectTitle || 'Untitled Adventure'"></strong></p>
        <div class="u-font-mono" style="font-size: 0.8125rem; color: var(--color-outline-dark);">
          <span x-text="'Brought by: ' + (myArchetype ? ($store.compass.archetypes[myArchetype]?.name || myArchetype) : 'Still Exploring')"></span>
          <span> · </span>
          <span x-text="'Looking for: ' + (neededArchetype === 'open' ? 'A Mix / Open Exploration' : ($store.compass.archetypes[neededArchetype]?.name || 'Open Collaboration'))"></span>
        </div>
      </div>

      <div class="o-cluster" style="gap: var(--space-md);">
        <button type="button" @click="resetForm()" class="c-btn c-btn--secondary">Submit Another Spark ↗</button>
        <a href="/" class="c-btn c-btn--primary">Return Home ↗</a>
        <a href="/notes/" class="c-btn c-btn--secondary">Read Notes from the Field ↗</a>
      </div>
    </div>

    <!-- The Guided Form -->
    <form action="{{ site.formspreeEndpoint | default('https://formspree.io/f/placeholder') }}" method="POST" @submit.prevent="submitForm()" x-show="!submitted">
      <!-- Formspree Spam Mitigation Honeypot -->
      <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />
      
      <!-- Error Notification Banner -->
      <div 
        class="c-form-error" 
        x-show="errorMessage" 
        x-cloak
        role="alert"
        style="padding: var(--space-md); margin-bottom: var(--space-lg); border-left: 3px solid var(--color-muted-clay); background: var(--color-surface-container-low); color: var(--color-primary);"
      >
        <p class="u-font-mono" style="font-size: 0.8125rem; margin: 0;" x-text="errorMessage"></p>
      </div>

      <!-- Section 1: Your Perspective / Archetype (Optional) -->
      <fieldset class="c-form-fieldset">
        <legend class="c-form-legend">01 · Your Perspective (Optional)</legend>
        <p style="font-size: 0.9375rem; color: var(--color-on-surface-variant); margin-bottom: var(--space-md); line-height: 1.5;">
          What energy or instinct do you naturally bring to this idea? 
          <span x-show="!$store.compass.result">
            (Haven't taken our quiz yet? <a href="/#your-compass" style="color: var(--color-primary); text-decoration: underline;">Find your compass in 2 minutes ↗</a>)
          </span>
        </p>

        <div class="c-archetype-grid" role="radiogroup" aria-label="Select your archetype (optional)">
          {% for key, arch in compass.archetypes %}
            <label class="c-archetype-choice" :class="{ 'is-selected': myArchetype === '{{ key }}' }">
              <input 
                type="radio" 
                name="my_archetype" 
                value="{{ key }}" 
                x-model="myArchetype" 
                class="u-visually-hidden"
              />
              <img 
                src="/assets/{{ arch.icon }}.svg" 
                alt="" 
                aria-hidden="true" 
                class="c-archetype-choice__icon" 
                width="24" 
                height="24" 
              />
              <div>
                <span class="c-archetype-choice__name">{{ arch.name }}</span>
                <p class="c-archetype-choice__desc">{{ arch.gift }}</p>
              </div>
            </label>
          {% endfor %}

          <!-- Option 6: Still Exploring / Unsure -->
          <label class="c-archetype-choice" :class="{ 'is-selected': myArchetype === '' || myArchetype === 'unsure' }">
            <input 
              type="radio" 
              name="my_archetype" 
              value="" 
              x-model="myArchetype" 
              class="u-visually-hidden"
            />
            <img 
              src="/assets/question.svg" 
              alt="" 
              aria-hidden="true" 
              class="c-archetype-choice__icon" 
              width="24" 
              height="24" 
            />
            <div>
              <span class="c-archetype-choice__name">Still Exploring</span>
              <p class="c-archetype-choice__desc">Not sure yet or haven't taken the compass.</p>
            </div>
          </label>
        </div>
      </fieldset>

      <!-- Section 2: Complementary Energy Needed -->
      <fieldset class="c-form-fieldset">
        <legend class="c-form-legend">02 · What This Project Needs Most</legend>
        <p style="font-size: 0.9375rem; color: var(--color-on-surface-variant); margin-bottom: var(--space-md); line-height: 1.5;">
          Great ventures thrive on complementary strengths. What kind of energy is missing or needed to help this project take shape?
        </p>

        <div class="c-archetype-grid" role="radiogroup" aria-label="Select needed archetype">
          {% for key, arch in compass.archetypes %}
            <label class="c-archetype-choice" :class="{ 'is-selected': neededArchetype === '{{ key }}' }">
              <input 
                type="radio" 
                name="needed_archetype" 
                value="{{ key }}" 
                x-model="neededArchetype" 
                class="u-visually-hidden"
              />
              <img 
                src="/assets/{{ arch.icon }}.svg" 
                alt="" 
                aria-hidden="true" 
                class="c-archetype-choice__icon" 
                width="24" 
                height="24" 
              />
              <div>
                <span class="c-archetype-choice__name">{{ arch.name }}</span>
                <p class="c-archetype-choice__desc">{{ arch.tagline }}</p>
              </div>
            </label>
          {% endfor %}

          <!-- Option 6: A Mix / Unsure / Open -->
          <label class="c-archetype-choice" :class="{ 'is-selected': neededArchetype === 'open' }">
            <input 
              type="radio" 
              name="needed_archetype" 
              value="open" 
              x-model="neededArchetype" 
              class="u-visually-hidden"
            />
            <img 
              src="/assets/question.svg" 
              alt="" 
              aria-hidden="true" 
              class="c-archetype-choice__icon" 
              width="24" 
              height="24" 
            />
            <div>
              <span class="c-archetype-choice__name">A Mix / Not Sure Yet</span>
              <p class="c-archetype-choice__desc">Looking for more than one strength, or open to discovery.</p>
            </div>
          </label>
        </div>
      </fieldset>

      <!-- Section 3: The Spark & Project Details -->
      <fieldset class="c-form-fieldset">
        <legend class="c-form-legend">03 · The Project &amp; Contact</legend>

        <div class="c-form-group">
          <label class="c-label" for="inquiry-name">
            <span>Your Name</span>
            <span class="c-label__hint">Required</span>
          </label>
          <input 
            type="text" 
            id="inquiry-name" 
            name="name"
            autocomplete="name"
            x-model="name" 
            required 
            class="c-input" 
            placeholder="Jane Doe" 
          />
        </div>

        <div class="c-form-group">
          <label class="c-label" for="inquiry-email">
            <span>Email Address</span>
            <span class="c-label__hint">Required</span>
          </label>
          <input 
            type="email" 
            id="inquiry-email" 
            name="email"
            autocomplete="email"
            x-model="email" 
            required 
            class="c-input" 
            placeholder="jane@example.com" 
          />
        </div>

        <div class="c-form-group">
          <label class="c-label" for="inquiry-title">
            <span>Working Title or Idea Name</span>
            <span class="c-label__hint">Optional</span>
          </label>
          <input 
            type="text" 
            id="inquiry-title" 
            name="project_title"
            x-model="projectTitle" 
            class="c-input" 
            placeholder="e.g. The Sunday Supper Guild / A Small Workshop Series" 
          />
        </div>

        <!-- Project Stage -->
        <div class="c-form-group">
          <span class="c-label">Where does it live right now?</span>
          <div class="c-stage-grid" role="radiogroup" aria-label="Project stage">
            <label class="c-stage-choice" :class="{ 'is-selected': stage === 'sketch' }">
              <input type="radio" name="project_stage" value="sketch" x-model="stage" />
              <span>A rough sketch in a notebook</span>
            </label>
            <label class="c-stage-choice" :class="{ 'is-selected': stage === 'prototype' }">
              <input type="radio" name="project_stage" value="prototype" x-model="stage" />
              <span>A recipe or prototype in progress</span>
            </label>
            <label class="c-stage-choice" :class="{ 'is-selected': stage === 'active' }">
              <input type="radio" name="project_stage" value="active" x-model="stage" />
              <span>An active project ready to expand</span>
            </label>
            <label class="c-stage-choice" :class="{ 'is-selected': stage === 'open' }">
              <input type="radio" name="project_stage" value="open" x-model="stage" />
              <span>Looking for good company to start</span>
            </label>
            <label class="c-stage-choice" :class="{ 'is-selected': stage === 'execution' }">
              <input type="radio" name="project_stage" value="execution" x-model="stage" />
              <span>Just the specs / Ready for execution</span>
            </label>
          </div>
        </div>

        <div class="c-form-group">
          <label class="c-label" for="inquiry-spark">
            <span>Tell us about the spark</span>
            <span class="c-label__hint">Required</span>
          </label>
          <textarea 
            id="inquiry-spark" 
            name="spark"
            x-model="spark" 
            required 
            class="c-textarea" 
            rows="4" 
            placeholder="What is the idea? What question, itch, or functional requirement made you want to start it?"
          ></textarea>
        </div>

        <div class="c-form-group">
          <label class="c-label" for="inquiry-support">
            <span>What kind of collaboration or help are you looking for?</span>
            <span class="c-label__hint">Optional</span>
          </label>
          <textarea 
            id="inquiry-support" 
            name="support_needed"
            x-model="support" 
            class="c-textarea" 
            rows="3" 
            placeholder="Design, storytelling, technical architecture, recipe development, workflow drafting, a mix of skills..."
          ></textarea>
        </div>
      </fieldset>

      <!-- Submit Action -->
      <div style="margin-top: var(--space-xl); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-md);">
        <button 
          type="submit" 
          class="c-btn c-btn--primary" 
          :disabled="isSubmitting"
          style="font-size: 0.875rem; padding: 1rem 2rem;"
        >
          <span x-show="!isSubmitting">Send Project Spark ↗</span>
          <span x-show="isSubmitting" x-cloak>Sending Dispatch...</span>
        </button>

        <p class="u-font-mono u-text-muted" style="font-size: 0.75rem;">
          Direct inquiries always welcome at <a href="mailto:{{ site.contactEmail }}" style="color: inherit; text-decoration: underline;">{{ site.contactEmail }}</a>
        </p>
      </div>
    </form>
  </div>
</section>
</div>

