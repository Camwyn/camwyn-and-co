{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 20000,
    "runners": [
      "axe",
      "htmlcs"
    ],
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "urls": [
    "http://localhost:8080/",
    "http://localhost:8080/our-story/",
    "http://localhost:8080/what-we-do/"
  ]
}

